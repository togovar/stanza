{{#with error}}
  <div class="alert alert-danger">{{message}}</div>
{{else}}
  <table class="table">
    <thead>
      <tr>
        <th>Transcript ID</th>
        <th>Gene symbol</th>
        <th>Consequence type</th>
        <th>HGVS(cDNA)</th>
        <th>HGVS(Amino acid seq.)</th>
        <th>CADD (PHRED score)</th>
        <th>AlphaMissense</th>
        <th>SIFT</th>
        <th>PolyPhen</th>
      </tr>
    </thead>

    <tbody>
      {{#each result}}
        <tr>
          <td>
            {{#if transcript.url}}
              <a
                href="{{transcript.url}}"
                target="_blank"
                rel="noopener noreferrer"
              >{{transcript.label}}<span class="external-link-icon"></span></a>
            {{else}}
              {{transcript.label}}
            {{/if}}
            {{#if is_mane_select}}
              <a
                class="mane-badge{{#unless transcript.label}} -no-transcript-id{{/unless}}"
                href="{{mane_url}}"
                target="_blank"
                rel="noopener noreferrer"
              >MANE</a>
            {{/if}}
          </td>
          <td>
            {{#if gene_xref}}
              <a
                href="{{gene_xref}}"
                target="_blank"
                rel="noopener noreferrer"
              >{{gene_symbol}}<span class="external-link-icon"></span></a>
            {{else}}
              {{gene_symbol}}
            {{/if}}
          </td>
          <td>
            <ul class="no-bullet">
              {{#each consequence_label}}
                <li>{{this}}</li>
              {{/each}}
            </ul>
          </td>
          <td>{{hgvs_c}}</td>
          <td>{{hgvs_p}}</td>
          <td class="cadd">
            <span
              class="variant-function"
              data-function="{{cadd_phred_class}}"
            >{{cadd_phred}}</span>
          </td>
          <td class="alphamissense">
            <span
              class="variant-function"
              data-function="{{alpha_missense_class}}"
            >{{alpha_missense}}</span>
            <span class="alphamissense-label">{{alpha_missense_label}}</span>
          </td>
          <td class="sift">
            <span
              class="variant-function"
              data-function="{{sift_class}}"
            >{{sift}}</span>
            <span class="sift-label">{{sift_label}}</span>
          </td>
          <td class="polyphen">
            <span
              class="variant-function"
              data-function="{{polyphen_class}}"
            >{{polyphen}}</span>
            <span class="polyphen-label">{{polyphen_label}}</span>
          </td>
        </tr>
      {{else}}
        <tr>
          <td colspan="9" class="text-center">No data</td>
        </tr>
      {{/each}}
    </tbody>
  </table>
{{/with}}

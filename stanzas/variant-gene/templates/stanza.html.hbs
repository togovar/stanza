{{#with error}}
  <div class="alert alert-danger">{{message}}</div>
{{else}}
  {{#with result}}
    <dl class="variant-gene-list">
      <dt>HGNC/Approved name</dt>
      <dd>{{approved_name}}</dd>

      <dt>HGNC/Approved symbol</dt>
      <dd>
        <ul class="gene-values">
          {{#each symbol}}
            <li><a href="{{href}}">{{value}}</a></li>
          {{/each}}
        </ul>
      </dd>

      <dt>HGNC/Alias name</dt>
      <dd>
        <ul class="gene-values">
          {{#each synonym}}
            <li>{{this}}</li>
          {{/each}}
        </ul>
      </dd>
    </dl>
  {{/with}}
{{/with}}

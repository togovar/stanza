{{#with error}}
  <div class="alert alert-danger">{{message}}</div>
{{else}}
  <div>
    {{#with result}}
      <dl class="variant-summary-list">
        <dt>Variant type</dt>
        <dd class="variant-type-value"><span class="variant-value">{{type}}</span></dd>

        <dt>Ref / Alt</dt>
        <dd>
          <div class="ref-alt">
            <span class="ref" data-sum="{{ref_length}}">{{ref}}</span><span class="arrow"></span><span
              class="alt" data-sum="{{alt_length}}">{{alt}}</span>
          </div>
        </dd>

        <dt>Position</dt>
        <dd>
          <span class="chromosome">{{chr}}</span>:<span class="position">{{position}}</span> <span
            class="assembly">({{assembly}})</span>
        </dd>
      </dl>
    {{/with}}
  </div>
{{/with}}
